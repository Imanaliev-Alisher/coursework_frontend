openapi: 3.0.3
info:
  title: АИС "Расписание занятий" API
  version: 1.0.0
  description: REST API для автоматизированной информационной системы управления расписанием
    учебных занятий
paths:
  /api/v1/audience-types/:
    get:
      operationId: v1_audience_types_list
      description: Возвращает список всех типов аудиторий
      summary: Получить список типов аудиторий
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - Типы аудиторий
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAudiencesTypesList'
          description: ''
    post:
      operationId: v1_audience_types_create
      description: Создает новый тип аудитории
      summary: Создать тип аудитории
      tags:
      - Типы аудиторий
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AudiencesTypesRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AudiencesTypesRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AudiencesTypesRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AudiencesTypes'
          description: ''
  /api/v1/audience-types/{id}/:
    get:
      operationId: v1_audience_types_retrieve
      description: Возвращает информацию о типе аудитории
      summary: Получить тип аудитории
