components:
  schemas:
    AddStudents:
      type: object
      description: Сериализатор для добавления студентов в группу
      properties:
        student_ids:
          type: array
          items:
            type: integer
      required:
      - student_ids
    AddStudentsRequest:
      type: object
      description: Сериализатор для добавления студентов в группу
      properties:
        student_ids:
          type: array
          items:
            type: integer
      required:
      - student_ids
    AudiencesCreateUpdate:
      type: object
      description: Сериализатор для создания/обновления аудитории
      properties:
        auditorium_number:
          type: integer
          maximum: 32767
          minimum: 0
          title: Номер аудитории
          description: Введите номер аудитории
        auditorium_type:
          type: integer
          title: Тип аудитории
          description: Выберите тип аудитории
        floor_number:
          type: integer
          maximum: 32767
          minimum: 0
          title: Этаж
          description: Введите этаж на котором находиться аудитория
        building:
          type: integer
          title: Строение(Корпус)
          description: Выберите строение(корпус) в котором находится аудитория
        title:
          type: string
          title: Введите название аудитории
          description: Название (если не указано — сформируется автоматически)
          maxLength: 63
      required:
      - auditorium_number
      - auditorium_type
      - building
      - floor_number
    AudiencesCreateUpdateRequest:
      type: object
      description: Сериализатор для создания/обновления аудитории
      properties:
        auditorium_number:
          type: integer
          maximum: 32767
          minimum: 0
          title: Номер аудитории
          description: Введите номер аудитории
        auditorium_type:
          type: integer
          title: Тип аудитории
          description: Выберите тип аудитории
        floor_number:
          type: integer
          maximum: 32767
          minimum: 0
          title: Этаж
