    get:
      operationId: v1_subject_schedules_list
      description: "Возвращает список всех временных слотов расписания с полной информацией:\n\
        \        - День недели и время занятия\n        - Информация о предмете (название,\
        \ тип)\n        - Детали аудитории (номер, этаж, корпус)\n        - Список\
        \ групп (ID и названия)\n        - Список преподавателей (ID, имя пользователя,\
        \ ФИО)\n        - Тип недели (Четные/Нечетные/Все)\n        \n        Поддерживает\
        \ фильтрацию по:\n        - subject: ID предмета\n        - day: ID дня недели\n\
        \        - time_slot: ID временного слота\n        - week_type: тип недели\
        \ (Четные/Нечетные/Все)\n        - group: ID группы (для получения расписания\
        \ конкретной группы)\n        - teacher: ID преподавателя (для получения расписания\
        \ преподавателя)\n        "
      summary: Получить список расписаний
      parameters:
      - in: query
        name: day
        schema:
          type: integer
        description: Фильтр по ID дня недели
      - in: query
        name: group
        schema:
          type: integer
        description: Фильтр по ID группы
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: subject
        schema:
          type: integer
        description: Фильтр по ID предмета
      - in: query
        name: teacher
        schema:
          type: integer
        description: Фильтр по ID преподавателя
      - in: query
        name: time_slot
        schema:
          type: integer
        description: Фильтр по ID временного слота
      - in: query
        name: week_type
        schema:
          type: string
        description: Фильтр по типу недели (Четные/Нечетные/Все)
      tags:
      - Расписание
      security:
      - jwtAuth: []
      responses:
